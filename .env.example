# 任意 OpenAI-compatible 端点。内网切 MaaS 时只改这三个值。
TAX_AGENT_BASE_URL=https://api.deepseek.com/v1
TAX_AGENT_API_KEY=sk-xxxxxxxx
TAX_AGENT_MODEL=deepseek-chat

# 日志级别，默认 INFO。可选 DEBUG/INFO/WARNING/ERROR/CRITICAL（loguru 内置级别名）。
TAX_AGENT_LOG_LEVEL=INFO

# --- TLS / 代理（内网联调）---
# 内网有两个彼此独立的障碍，对应下面两个变量，不要混为一谈。
#
# 1. 自签证书。**正解是喂内网根 CA**，不是关掉校验：
# TAX_AGENT_CA_BUNDLE=/path/to/corp-root-ca.pem
#
#    拿不到根 CA 时才用下面这个显式降级。注意模型请求也走这套配置，
#    关掉校验意味着中间人能直接拿走 api_key，所以默认不生效、必须显式打开：
# TAX_AGENT_INSECURE_TLS=1
#
# 2. HIS 系统代理会 407 拦截内网直连，所以默认**不读** HTTP_PROXY 等变量。
#    需要经代理访问外网端点时才打开：
# TAX_AGENT_TRUST_ENV=1

# 生产部署设为 prod：关掉 server.py 启动时自动读 .env 的行为，
# 避免开发机配置在生产悄悄生效（生产由部署平台注入环境变量）。
# TAX_AGENT_ENV=prod

# --- 检索源 ---
# local       样本库 data/clauses.json（缺省）
# ttc_public  应用级凭证（APIC/APIGW）调 TTC 公有 API 拿真实数据。**仅限本地开发**：
#             没有用户身份，维度权限不生效，且公有 API 不返回失效/归档标志，
#             已废止条款会呈现为现行有效。不要用在生产。
# ttc_user    透传用户 IAM token 调 TTC 私有接口。生产路径。
TAX_AGENT_SOURCE=local

# --- 以下只有 TAX_AGENT_SOURCE=ttc_public / ttc_user 时才需要 ---

# TTC 服务根地址（不含 /fin/ttc/publicservices/... 路径段，代码里拼）。
TTC_BASE_URL=https://ttc.internal.example.com

# APIGW 静态 AK/SK（优先于 APIC，二选一即可）。仅 ttc_public 用。
TTC_APIGW_ID=xxxxxxxx
TTC_APIGW_APPKEY=xxxxxxxx

# APIC 应用级凭证（APIGW 未配置时使用）。仅 ttc_public 用。
# TTC_APIC_TOKEN_URL 是 APIC 服务根地址，换 token 的路径由代码拼。
TTC_APIC_TOKEN_URL=https://apic.internal.example.com
TTC_APIC_APP_ID=xxxxxxxx
TTC_APIC_SECRET=xxxxxxxx
